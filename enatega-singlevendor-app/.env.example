# Single-vendor-only is the default for this release. Set this explicitly to
# false to restore the combined single/multivendor selector.
EXPO_PUBLIC_DEFAULT_SINGLE_VENDOR=true

EXPO_PUBLIC_SINGLE_VENDOR_GRAPHQL_URL=https://your-api.example.com/graphql
EXPO_PUBLIC_SINGLE_VENDOR_WS_GRAPHQL_URL=wss://your-api.example.com/graphql
EXPO_PUBLIC_SINGLE_VENDOR_REST_URL=https://your-api.example.com/
