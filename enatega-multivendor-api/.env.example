# ---------------------------------------------------------------------------
# Enatega API configuration. Copy to .env and fill in the values.
# Required values are marked [required]. Everything else has a safe default.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=8001
LOG_LEVEL=info
# Public base URL of this API (used for payment redirect URLs and local uploads).
PUBLIC_API_URL=https://api.example.com
# [required in production] Comma-separated browser origins (customer web + admin dashboards).
CORS_ORIGINS=https://www.example.com,https://admin.example.com
# Number of reverse proxies in front of the API (for correct client IPs / rate limiting).
TRUST_PROXY=1

# [required] MongoDB (replica set recommended: transactions + reliability).
MONGODB_URI=mongodb://localhost:27017/enatega?replicaSet=rs0
# [required in production] Redis: subscriptions across instances, rate limiting, OTP storage.
REDIS_URL=redis://localhost:6379

# [required] Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# [required] 32-byte key (64 hex chars) used to encrypt third-party secrets saved by admins.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
JWT_ACCESS_TTL=7d
JWT_DASHBOARD_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d

# First super admin (created on first boot when no admin exists).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Require the public access token handshake (metricsGeneral + bop-auth + nonce) for anonymous calls.
PUBLIC_ACCESS_REQUIRED=false
# GraphQL hardening
GRAPHQL_INTROSPECTION=false
GRAPHQL_MAX_DEPTH=14
GRAPHQL_MAX_ALIASES=30
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# Uploads: local | s3 | cloudinary
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Integrations (optional; values saved in the admin dashboard take precedence)
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_IDS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_SANDBOX=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
EXPO_ACCESS_TOKEN=
# Firebase service account JSON (single line) for web push notifications
FIREBASE_SERVICE_ACCOUNT_JSON=

# Store-review / demo accounts that accept DEMO_OTP (never list real users)
DEMO_OTP=
DEMO_ACCOUNTS=

# Background jobs
JOBS_ENABLED=true
# Auto-cancel orders not accepted by the store within N minutes (0 = disabled)
ORDER_ACCEPT_TIMEOUT_MINUTES=0
# Optional bearer token for /metrics (otherwise only private networks may scrape in production)
METRICS_TOKEN=
