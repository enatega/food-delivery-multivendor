{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@playwright/test"
    ]
  },
  "include": [
    "playwright.config.ts",
    "scripts/**/*.js",
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "extends": "expo/tsconfig.base",
  "exclude": [
    "tests/unit/customer-web-business-logic.spec.ts"
  ]
}
