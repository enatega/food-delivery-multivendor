{
  "name": "@enatega/qa-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "qa:validate-env": "playwright test tests/preflight/environment.spec.ts --project=preflight --reporter=line",
    "test": "npm run test:unit",
    "test:unit": "playwright test tests/unit",
    "test:contract": "playwright test --project=contract",
    "test:web": "playwright test tests/web",
    "test:web:p1": "QA_RUN_MODE=mock QA_START_CUSTOMER_WEB=true playwright test --project=customer-mock-chromium --workers=1",
    "test:web:mock": "QA_RUN_MODE=mock QA_START_CUSTOMER_WEB=true playwright test --project=customer-mock-chromium",
    "test:web:qa": "QA_RUN_MODE=qa playwright test --project=customer-qa-chromium",
    "test:web:mobile": "QA_RUN_MODE=mock QA_START_CUSTOMER_WEB=true playwright test --project=customer-mobile-chromium",
    "test:web:cross-browser": "QA_RUN_MODE=mock QA_START_CUSTOMER_WEB=true playwright test --project=customer-firefox --project=customer-webkit",
    "test:web:production-smoke": "QA_RUN_MODE=production-readonly QA_START_CUSTOMER_WEB=true QA_USE_FRONTEND_ENV=true playwright test --project=customer-production-smoke --workers=1",
    "auth:web:production": "QA_RUN_MODE=production-readonly QA_START_CUSTOMER_WEB=true QA_USE_FRONTEND_ENV=true playwright test --project=customer-production-auth-setup --workers=1",
    "test:web:production-authenticated": "QA_RUN_MODE=production-readonly QA_START_CUSTOMER_WEB=true QA_USE_FRONTEND_ENV=true playwright test --project=customer-production-authenticated --workers=1",
    "test:web:production-order": "QA_RUN_MODE=production-readonly QA_START_CUSTOMER_WEB=true QA_USE_FRONTEND_ENV=true playwright test --project=customer-production-order --workers=1",
    "test:web:production-order-smoke": "QA_RUN_MODE=production-readonly QA_START_CUSTOMER_WEB=true QA_USE_FRONTEND_ENV=true playwright test --project=customer-production-order-smoke --workers=1",
    "test:web:production-order-smoke:ui": "QA_RUN_MODE=production-readonly QA_START_CUSTOMER_WEB=true QA_USE_FRONTEND_ENV=true QA_STOP_BEFORE_ORDER=true playwright test --project=customer-production-order-smoke --workers=1 --ui",
    "test:web:production-order-smoke:watch": "QA_RUN_MODE=production-readonly QA_START_CUSTOMER_WEB=true QA_USE_FRONTEND_ENV=true QA_STOP_BEFORE_ORDER=true playwright test --project=customer-production-order-smoke --workers=1 --headed --trace on --video on",
    "test:web:production-order-smoke:trace": "QA_RUN_MODE=production-readonly QA_START_CUSTOMER_WEB=true QA_USE_FRONTEND_ENV=true playwright test --project=customer-production-order-smoke --workers=1 --trace on --video on",
    "report:trace": "npx playwright show-trace \"$(ls -td reports/test-results/*/ | head -1)trace.zip\"",
    "test:web:ui": "QA_RUN_MODE=mock QA_START_CUSTOMER_WEB=true playwright test --project=customer-mock-chromium --ui",
    "test:web:production-smoke:ui": "QA_RUN_MODE=production-readonly QA_START_CUSTOMER_WEB=true QA_USE_FRONTEND_ENV=true playwright test --project=customer-production-smoke --workers=1 --ui",
    "test:web:production-authenticated:ui": "QA_RUN_MODE=production-readonly QA_START_CUSTOMER_WEB=true QA_USE_FRONTEND_ENV=true playwright test --project=customer-production-authenticated --workers=1 --no-deps --ui",
    "test:web:production-order:ui": "QA_RUN_MODE=production-readonly QA_START_CUSTOMER_WEB=true QA_USE_FRONTEND_ENV=true playwright test --project=customer-production-order --workers=1 --ui",
    "mobile:preflight:ios": "node scripts/mobile-runner.js preflight",
    "mobile:preflight:cloud": "node scripts/mobile-runner.js preflight --cloud",
    "test:mobile:ios:smoke": "node scripts/mobile-runner.js smoke",
    "test:mobile:ios:regression": "node scripts/mobile-runner.js regression",
    "test:mobile:ios:multi-vendor": "node scripts/mobile-runner.js multi-vendor",
    "test:mobile:ios:navigation": "node scripts/mobile-runner.js navigation",
    "test:mobile:ios:production-order": "node scripts/mobile-runner.js production-order",
    "test:mobile:cloud:smoke": "node scripts/mobile-runner.js smoke --cloud",
    "test:mobile:cloud:regression": "node scripts/mobile-runner.js regression --cloud",
    "test:mobile:cloud:multi-vendor": "node scripts/mobile-runner.js multi-vendor --cloud",
    "test:mobile:cloud:navigation": "node scripts/mobile-runner.js navigation --cloud",
    "test:mobile:cloud:production-order": "node scripts/mobile-runner.js production-order --cloud",
    "mobile:preflight:e2e": "node scripts/e2e-runner.js --preflight",
    "test:mobile:e2e": "node scripts/e2e-runner.js",
    "report:mobile": "node scripts/mobile-report.js",
    "report:web": "playwright show-report reports/playwright",
    "report:slack": "node scripts/slack-report.js",
    "slack:unit": "node scripts/run-with-slack.js unit",
    "slack:contract": "node scripts/run-with-slack.js contract",
    "slack:web:mock": "node scripts/run-with-slack.js web:mock",
    "slack:web:production-smoke": "node scripts/run-with-slack.js web:production-smoke",
    "slack:web:production-authenticated": "node scripts/run-with-slack.js web:production-authenticated",
    "slack:web:production-order-smoke": "node scripts/run-with-slack.js web:production-order-smoke",
    "slack:mobile:smoke": "node scripts/run-with-slack.js mobile:smoke",
    "slack:mobile:regression": "node scripts/run-with-slack.js mobile:regression",
    "slack:mobile:navigation": "node scripts/run-with-slack.js mobile:navigation",
    "slack:mobile:e2e": "node scripts/run-with-slack.js mobile:e2e",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.4",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "expo": "^57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
