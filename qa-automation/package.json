{
  "name": "@enatega/qa-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "qa:validate-env": "playwright test tests/preflight/environment.spec.ts --project=preflight --reporter=line",
    "test": "npm run test:unit",
    "test:unit": "playwright test tests/unit",
    "test:web": "playwright test tests/web",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
