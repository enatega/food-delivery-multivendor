# Non-secret QA target identity. Never use production or public demo values.
QA_ENV=true
QA_RUN_MODE=qa
QA_CUSTOMER_WEB_URL=https://customer.qa.example.test
QA_GRAPHQL_URL=https://api.qa.example.test/graphql
QA_TENANT_ID=AUTOMATION_DAILY
QA_DATABASE_NAME=enatega_qa

QA_MOBILE_ALLOW_PRODUCTION_WRITES=true
# Explicit comma-separated mutation allowlists.
QA_ALLOWED_WEB_HOSTNAMES=customer.qa.example.test
QA_ALLOWED_HOSTNAMES=api.qa.example.test
QA_ALLOWED_TENANT_IDS=AUTOMATION_DAILY
QA_ALLOWED_DATABASE_NAMES=enatega_qa

# Stable Customer Web fixtures maintained by QA.
QA_LOCALE=en
QA_CUSTOMER_LATITUDE=33.6844
QA_CUSTOMER_LONGITUDE=73.0479
QA_AUTOMATION_STORE_ID=
QA_AUTOMATION_PRODUCT_ID=
QA_AUTOMATION_COUPON=

# Secrets belong in .env.local or the CI secret store, never in this file.
QA_CUSTOMER_EMAIL=
QA_CUSTOMER_PASSWORD=
QA_STORE_EMAIL=
QA_STORE_PASSWORD=
QA_RIDER_EMAIL=
QA_RIDER_PASSWORD=
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# Customer iOS Maestro smoke. Copy these placeholders into
# .env.mobile.local; never put real credentials in this tracked file.
QA_MOBILE_ENV=production
QA_MOBILE_APP_ID=com.enatega.multivendor.qa
QA_MOBILE_GRAPHQL_URL=https://aws-server-v2.enatega.com/graphql
QA_MOBILE_ALLOWED_HOSTNAMES=aws-server-v2.enatega.com
QA_MOBILE_RESTAURANT_NAME=
QA_MOBILE_PRODUCT_NAME=
QA_MOBILE_OPTION_ID=
# Multi-vendor flows only (npm run test:mobile:ios:multi-vendor). Read-only.
QA_MOBILE_SECOND_RESTAURANT_NAME=
QA_MOBILE_SECOND_PRODUCT_ID=
QA_MOBILE_CURRENCY=
QA_MAX_ORDER_TOTAL=

# Manual production order only. The runner requires every value and accepts
# pickup + COD only. Leave both opt-in switches false in templates.
QA_MOBILE_ALLOW_PRODUCTION_WRITES=false
QA_PLACE_REAL_ORDER=false
QA_MOBILE_RESTAURANT_ID=
QA_MOBILE_PRODUCT_ID=
QA_MOBILE_FULFILLMENT=pickup
QA_MOBILE_PAYMENT_METHOD=COD

# ---------------------------------------------------------------
# Three-app end-to-end (npm run test:mobile:e2e).
#
# Customer places a REAL delivery order, the store accepts it and the rider
# carries it to DELIVERED. Nothing in this suite cancels the order, so all
# three switches below stay false in templates and are turned on deliberately,
# per run, in .env.mobile.local.
#
# Note QA_MOBILE_FULFILLMENT: the E2E needs "delivery". The customer-only
# production-order flow needs "pickup". They cannot both run from one file
# without editing this value.
# ---------------------------------------------------------------
QA_E2E_COMPLETE_REAL_ORDER=false

# Store and rider accounts that serve QA_MOBILE_RESTAURANT_NAME on production.
QA_STORE_USERNAME=
QA_RIDER_USERNAME=
# QA_STORE_PASSWORD / QA_RIDER_PASSWORD are declared above.

# Bundle IDs, overridden only for a differently-named local build.
QA_STORE_APP_ID=multivendor.enatega.restaurant
QA_RIDER_APP_ID=com.enatega.multirider

# One booted simulator per app; all three must differ.
# `xcrun simctl list devices booted` prints the UDIDs.
QA_CUSTOMER_DEVICE_UDID=
QA_STORE_DEVICE_UDID=
QA_RIDER_DEVICE_UDID=

# Preparation time the store picks when accepting: 10-90 in steps of 10.
QA_STORE_PREPARATION_TIME=20
# How long each app waits for the order to reach it through production
# subscriptions, in milliseconds.
QA_E2E_NEW_ORDER_TIMEOUT=120000

# --- Slack test-result notifications (optional) ---
# Set ONE of these. Without either, scripts/slack-report.js no-ops so local runs
# stay quiet. An incoming-webhook URL is locked to a single channel and never
# expires; a bot token needs chat:write and a SLACK_CHANNEL to aim at.
# NOTE: an `xoxe.xoxp-` app-configuration token cannot post — it has no
# chat:write scope and expires every 12 hours.
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
